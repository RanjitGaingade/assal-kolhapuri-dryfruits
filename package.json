    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2"
  },

  "overrides": {
    "deepmerge-ts": "8.0.0"
