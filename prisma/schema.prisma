generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  sku           String   @unique
  category      String
  purchasePrice Decimal
  sellingPrice  Decimal
  stockQuantity Int      @default(0)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
